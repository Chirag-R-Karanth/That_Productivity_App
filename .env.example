# Database (5434 avoids clashing with other local Postgres instances)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/productivity

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Google Calendar OAuth2
# GOOGLE_REDIRECT_URI is derived from WEB_APP_URL (webAppUrl + /api/auth/google/callback)
# by default. Set the (full, with /api/auth/google/callback) URI explicitly only when the
# backend is NOT behind the same origin as the web app, e.g. local dev where the backend
# answers on :4000 directly:
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin reachable by your browser; the Google OAuth flow redirects back to
# <WEB_APP_URL>/settings?google=linked after linking. Default: http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Web Push (VAPID) — attendance prompts and other notifications on the web.
# Generate a pair once, then keep it:
#   pnpm --filter backend exec web-push generate-vapid-keys --json
# The public key is handed to the browser and is safe to expose. The private
# key signs every push the server sends and must never leave it. Rotating the
# pair invalidates every existing browser subscription, so users have to
# re-enable notifications once after a change.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service attributes abuse reports to. Chrome accepts a mailto: or
# an https:// address and refuses anything else, so this cannot be left blank in
# a deployment that expects push to work.
VAPID_SUBJECT=mailto:notifications@example.com

# Firebase Cloud Messaging (Android push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Server
PORT=4000
NODE_ENV=development

# Web PWA
# Local dev: point the browser at the running API.
# Docker self-host (docker-compose.prod.yml): leave empty — the app talks to the
# same origin via /api/* (nginx reverse-proxies to the backend).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mobile (bundled at build time via EXPO_PUBLIC_API_URL)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000

# Production stack (docker-compose.prod.yml)
# PRODAPP_PORT=8080   # host port exposed by the nginx reverse proxy
