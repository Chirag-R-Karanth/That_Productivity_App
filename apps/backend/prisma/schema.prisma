// Prisma 7 schema — PostgreSQL
// Design note: everything soft-deleteable (Task) keeps deleted_at.
// Session scheduling constraints (course schedule, class times) intentionally
// stay as JSON to avoid over-normalizing; queries never need to index inside them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- User & settings ----------

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  passwordHash String?
  authProvider AuthProvider @default(PASSWORD)

  googleRefreshToken  String? // encrypted at rest
  googleAccessToken   String? // encrypted at rest
  googleTokenExpiresAt DateTime?

  fcmToken String?

  // Settings (sensible defaults set in code, nullable here so we can tell
  // "unset" from "explicitly 25 minutes")
  attendanceAutoMarkHours Int? // null = stay unconfirmed forever
  pomodoroWorkMinutes     Int?
  pomodoroBreakMinutes    Int?
  pomodoroLongBreakMinutes Int?      // null = default 15
  pomodoroSessionsPerCycle Int?      // null = default 4
  chimeOnTheHour          Boolean  @default(true)
  onboardingComplete      Boolean  @default(false)

  // Per-type notification controls. Default on, because reaching them at all
  // requires granting the browser permission and registering a subscription;
  // these switches exist to turn a channel off, not to opt into it.
  notifyAttendance        Boolean  @default(true)
  notifyCalendar          Boolean  @default(true)
  notifyTasks             Boolean  @default(true)
  notifyFocus             Boolean  @default(true)

  // Capacity window. "Usable time" is never the whole gap between classes —
  // it is the awake day, minus fixed commitments, minus transition buffers.
  // Stored as minutes-from-midnight so the window is timezone-agnostic.
  // null = use the defaults applied in code (see services/dayModel.ts).
  dayStartMinutes   Int? // null = default 7:00
  dayEndMinutes     Int? // null = default 23:00
  bufferMinutes     Int? // null = default 10 — recovery time around each commitment

  // IANA zone ("Asia/Kolkata") used to decide which day it is, and where every
  // day boundary falls. A server running in UTC must not call 00:30 local
  // "yesterday". null = fall back to the zone the request reports, then UTC.
  timezone          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  courses        Course[]
  calendarEvents CalendarEvent[]
  attendanceRecords AttendanceRecord[]
  pomodoroSessions PomodoroSession[]
  googleCalendars  LinkedGoogleCalendar[]
  googleConnections GoogleConnection[]
  events         Event[]
  timetableEntries TimetableEntry[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// ---------- Tasks ----------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id        String @id @default(cuid())
  userId    String
  title     String
  notes     String?

  dueDate String? // YYYY-MM-DD
  dueTime String? // HH:MM (24h)

  // The day I have committed to actually doing this, which is deliberately
  // separate from dueDate (the deadline). A plan can be light on a heavy day.
  plannedDate String? // YYYY-MM-DD

  // Effort estimate in minutes. This is the only input to "how much work have
  // I planned", so it stays a single integer rather than a T-shirt size:
  // a size cannot be compared against minutes of real capacity.
  estimateMinutes Int?

  completed   Boolean  @default(false)
  completedAt DateTime?
  deletedAt   DateTime?

  priority TaskPriority @default(MEDIUM)

  // iCalendar RRULE, e.g. "FREQ=WEEKLY;BYDAY=FR"
  recurrenceRule String?
  // For recurring tasks: date of the most recent occurrence the user
  // completed. Occurs "active" past this date are treated as done.
  lastCompletedOccurrence String? // YYYY-MM-DD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // ---- Google Tasks ----
  // A task imported from Google. A Google task id is only unique within one
  // task list of one account, so identity is the triple below.
  connectionId     String?
  googleTaskListId String?
  googleTaskId     String?
  /// Google's optimistic-concurrency token. A write returning 412 lost the
  /// race, and the safe move is to re-read rather than overwrite.
  googleETag       String?
  /// A task deleted in Google. Kept as a tombstone so a later sync does not
  /// resurrect it from a stale local copy.
  googleDeleted    Boolean  @default(false)
  /// When this row was last pushed successfully to Google.
  googlePushedAt   DateTime?

  connection GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions PomodoroSession[]

  @@index([userId, deletedAt])
  @@index([userId, courseId])
  @@index([userId, dueDate])
  @@index([userId, plannedDate])
  @@index([userId, connectionId, googleTaskId])
  @@map("tasks")
}

// ---------- Courses & timetable ----------

model Course {
  id     String @id @default(cuid())
  userId String
  name   String
  code   String?
  // [{ "dayOfWeek": 1, "startTime": "09:00", "endTime": "10:30" }]
  schedule Json  @default("[]")
  attendanceThreshold Int @default(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  attendanceRecords AttendanceRecord[]
  timetableEntries TimetableEntry[]

  @@index([userId])
  @@map("courses")
}

/// A dated exception to, or addition to, the recurring weekly timetable.
/// Additive: the weekly Course.schedule JSON is untouched.
enum TimetableEntryKind {
  EXAM
  HOLIDAY
  EXCEPTION
  RESCHEDULED
  EVENT
}

model TimetableEntry {
  id       String @id @default(cuid())
  userId   String
  /// Null for entries that belong to no course, e.g. a campus holiday.
  courseId String?
  title    String
  kind     TimetableEntryKind @default(EVENT)
  /// YYYY-MM-DD, interpreted in the user's timezone.
  date     String
  /// Null for all-day entries such as holidays.
  startTime String?
  endTime   String?
  location  String?
  notes     String?
  /// On RESCHEDULED entries: { dayOfWeek, startTime, endTime } of the slot moved.
  replacesSlot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, date, startTime])
  @@map("timetable_entries")
}

// ---------- Attendance ----------

enum AttendanceStatus {
  ATTENDED
  MISSED
  CANCELLED
  UNCONFIRMED
}

model AttendanceRecord {
  id        String @id @default(cuid())
  userId    String
  courseId  String
  date      String // YYYY-MM-DD
  status    AttendanceStatus @default(UNCONFIRMED)
  confirmedAt DateTime?

  /// When a push prompt was last sent for this record. Null means "never
  /// asked", which is what stops the 15-minute prompt cron from asking the
  /// same question all evening. Cleared when the prompt is dismissed, so a
  /// re-prompt is possible if the user genuinely never answered.
  attendancePromptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Cron must never double-generate a record for the same course+date.
  @@unique([courseId, date])
  @@index([userId, date])
  @@map("attendance_records")
}

// ---------- Calendar aggregation ----------

enum CalendarEventSource {
  LOCAL
  GOOGLE
}

model CalendarEvent {
  id        String @id @default(cuid())
  userId    String
  source    CalendarEventSource @default(LOCAL)
  googleEventId    String?
  sourceCalendarId String?
  /// Which linked Google account produced this row. A Google event id is only
  /// unique within one calendar of one account, so the previous key
  /// (userId, googleEventId, sourceCalendarId) collides the moment a second
  /// account is linked: both have a `primary` calendar and overlapping ids.
  connectionId     String?
  title     String
  description String?
  startTime DateTime
  endTime   DateTime
  allDay    Boolean @default(false)
  location  String?
  color     String?
  isDedupedDuplicate Boolean @default(false)
  isDeleted Boolean  @default(false)

  // Remote deletion detection (GCAL uses sync tokens / updated range)
  googleUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // A single Google event can appear across multiple calendars we dedup. All
  // the source rows are kept, so this is a lookup index rather than a
  // constraint: a remote event id is not unique on its own.
  @@index([userId, connectionId, googleEventId, sourceCalendarId])
  @@index([userId, startTime])
  @@map("calendar_events")
}

/// A Google account linked to one of our users.
///
/// Tokens live here rather than on User because a user can link more than one
/// Google account: each is a separate OAuth identity with its own calendars and
/// task lists. Seven Google accounts feeding one user is seven of these rows.
model GoogleConnection {
  id String @id @default(cuid())
  userId String

  /// Google's stable per-account id (the `sub` claim). An email address can
  /// change; this cannot, so a re-link matches on it.
  googleAccountId String
  email String
  displayName String?

  accessToken String // encrypted at rest
  refreshToken String? // encrypted at rest; absent when the grant was incremental
  tokenExpiresAt DateTime?
  scopes String?

  /// Set when Google refuses the refresh token. The usual causes are a revoked
  /// grant and an expired Testing-mode token, and the fix is a human clicking
  /// reconnect, so this is surfaced rather than retried forever.
  /// Google task list that locally created tasks are pushed to. Discovered from
  /// the account on first use rather than asked for, so an account that does
  /// not use Google Tasks costs nothing.
  defaultTaskListId String?

  needsRelink Boolean @default(false)
  lastSyncedAt DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars LinkedGoogleCalendar[]
  events CalendarEvent[]
  tasks Task[]

  /// One row per Google account per user. Re-linking the same account updates
  /// the existing row instead of accumulating duplicates.
  @@unique([userId, googleAccountId])
  @@index([userId, needsRelink])
  @@map("google_connections")
}

model LinkedGoogleCalendar {
  /// The Google calendar id. Not a key on its own: every Google account has a
  /// calendar called `primary`, so this value legitimately repeats -- once per
  /// linked account -- and the row is identified by the pair below.
  id          String
  userId      String
  /// Which Google account this calendar came from. A calendar id is only
  /// unique within its account, so `primary` can legitimately exist 7 times.
  connectionId String
  summary     String
  backgroundColor String?
  accessRole  String?
  isLinked    Boolean @default(true)
  // Kept in sync, but not counted as planned time. Opt-out, so existing
  // calendars keep reserving capacity as they always have.
  includeInDay Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, id])
  @@index([userId])
  @@map("linked_google_calendars")
}

// ---------- Pomodoro ----------

model PomodoroSession {
  id        String @id @default(cuid())
  userId    String
  taskId    String?

  startedAt DateTime
  durationMinutes Int
  completed Boolean  @default(true)

  // What actually happened, as opposed to what the timer intended.
  // durationMinutes is the plan; these are the outcome. Review compares the
  // two, which is the only way to learn that a task is chronically
  // underestimated. Both stay null for rows written before this existed.
  endedAt       DateTime?
  actualMinutes Int?

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("pomodoro_sessions")
}

// ---------- Offline sync ----------
// Actions queued on device are replayed here. The idempotency_key column makes
// double-apply safe, and updated_at provides last-write-wins basis.

model PendingSync {
  id        String @id @default(cuid())
  userId    String
  // "task.create" / "attendance.resolve" / ...
  actionType String

  // JSON payload of the client intent
  payload   Json
  idempotencyKey String @unique

  status    String @default("PENDING") // PENDING | APPLIED | FAILED
  error     String?
  createdAt DateTime @default(now())
  appliedAt DateTime?
}

// ---------- Immutable event log (analytics) ----------
// A chronological, append-only record of what happened. Events are never
// mutated or deleted after insert; analytics read from here instead of
// re-deriving history from mutating tables.

enum EventType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_UNCOMPLETED
  TASK_UPDATED
  TASK_DELETED
  FOCUS_STARTED
  FOCUS_COMPLETED
  FOCUS_CANCELLED
  ATTENDANCE_RECORDED
  CLASS_SCHEDULED
  CALENDAR_EVENT_SYNCED
  CALENDAR_EVENT_UPDATED
  GOOGLE_TASK_SYNCED
}

model Event {
  id         String    @id @default(cuid())
  userId     String
  type       EventType
  occurredAt DateTime  @default(now())
  payload    Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@map("events")
}

// ---------- Push notifications ----------
// One row per browser that has granted this app permission to notify it.

/// A Web Push subscription belonging to one of our users.
///
/// Rows live on `User` rather than on a device record because the browser
/// endpoint *is* the identity: it is unique per browser profile, survives a
/// reload, and is the exact string a push service needs to be handed. Storing
/// a key we could recompute instead would mean trusting our own copy of a
/// secret the browser will not give us back.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  /// The push service endpoint for this browser. Unique across all users: the
  /// same browser can only belong to one account, and re-subscribing must
  /// update the existing row instead of accumulating dead duplicates.
  endpoint String @unique
  p256dh   String
  auth     String
  /// Shown in Settings so a user with three devices can tell them apart.
  userAgent String?
  /// Consecutive delivery failures. A subscription that keeps failing is
  /// reported in Settings rather than silently retried forever.
  failureCount Int @default(0)
  lastError     String?
  lastUsedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}