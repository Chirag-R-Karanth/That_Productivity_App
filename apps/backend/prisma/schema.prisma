// Prisma 7 schema — PostgreSQL
// Design note: everything soft-deleteable (Task) keeps deleted_at.
// Session scheduling constraints (course schedule, class times) intentionally
// stay as JSON to avoid over-normalizing; queries never need to index inside them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- User & settings ----------

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  passwordHash String?
  authProvider AuthProvider @default(PASSWORD)

  googleRefreshToken  String? // encrypted at rest
  googleAccessToken   String? // encrypted at rest
  googleTokenExpiresAt DateTime?

  fcmToken String?

  // Settings (sensible defaults set in code, nullable here so we can tell
  // "unset" from "explicitly 25 minutes")
  attendanceAutoMarkHours Int? // null = stay unconfirmed forever
  pomodoroWorkMinutes     Int?
  pomodoroBreakMinutes    Int?
  pomodoroLongBreakMinutes Int?      // null = default 15
  pomodoroSessionsPerCycle Int?      // null = default 4
  chimeOnTheHour          Boolean  @default(true)
  onboardingComplete      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  courses        Course[]
  calendarEvents CalendarEvent[]
  attendanceRecords AttendanceRecord[]
  pomodoroSessions PomodoroSession[]
  googleCalendars  LinkedGoogleCalendar[]
  events         Event[]

  @@map("users")
}

// ---------- Tasks ----------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id        String @id @default(cuid())
  userId    String
  title     String
  notes     String?

  dueDate String? // YYYY-MM-DD
  dueTime String? // HH:MM (24h)

  completed   Boolean  @default(false)
  completedAt DateTime?
  deletedAt   DateTime?

  priority TaskPriority @default(MEDIUM)

  // iCalendar RRULE, e.g. "FREQ=WEEKLY;BYDAY=FR"
  recurrenceRule String?
  // For recurring tasks: date of the most recent occurrence the user
  // completed. Occurs "active" past this date are treated as done.
  lastCompletedOccurrence String? // YYYY-MM-DD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions PomodoroSession[]

  @@index([userId, deletedAt])
  @@index([userId, courseId])
  @@index([userId, dueDate])
  @@map("tasks")
}

// ---------- Courses & timetable ----------

model Course {
  id     String @id @default(cuid())
  userId String
  name   String
  code   String?
  // [{ "dayOfWeek": 1, "startTime": "09:00", "endTime": "10:30" }]
  schedule Json  @default("[]")
  attendanceThreshold Int @default(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  attendanceRecords AttendanceRecord[]

  @@index([userId])
  @@map("courses")
}

// ---------- Attendance ----------

enum AttendanceStatus {
  ATTENDED
  MISSED
  CANCELLED
  UNCONFIRMED
}

model AttendanceRecord {
  id        String @id @default(cuid())
  userId    String
  courseId  String
  date      String // YYYY-MM-DD
  status    AttendanceStatus @default(UNCONFIRMED)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Cron must never double-generate a record for the same course+date.
  @@unique([courseId, date])
  @@index([userId, date])
  @@map("attendance_records")
}

// ---------- Calendar aggregation ----------

enum CalendarEventSource {
  LOCAL
  GOOGLE
}

model CalendarEvent {
  id        String @id @default(cuid())
  userId    String
  source    CalendarEventSource @default(LOCAL)
  googleEventId    String?
  sourceCalendarId String?
  title     String
  description String?
  startTime DateTime
  endTime   DateTime
  allDay    Boolean @default(false)
  location  String?
  color     String?
  isDedupedDuplicate Boolean @default(false)
  isDeleted Boolean  @default(false)

  // Remote deletion detection (GCAL uses sync tokens / updated range)
  googleUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A single Google event can appear across multiple calendars we dedup.
  @@unique([userId, googleEventId, sourceCalendarId])
  @@index([userId, startTime])
  @@map("calendar_events")
}

model LinkedGoogleCalendar {
  id          String @id
  userId      String
  summary     String
  backgroundColor String?
  accessRole  String?
  // OAuth tokens are per-user; calendar-level metadata here only.
  isLinked    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@map("linked_google_calendars")
}

// ---------- Pomodoro ----------

model PomodoroSession {
  id        String @id @default(cuid())
  userId    String
  taskId    String?

  startedAt DateTime
  durationMinutes Int
  completed Boolean  @default(true)

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("pomodoro_sessions")
}

// ---------- Offline sync ----------
// Actions queued on device are replayed here. The idempotency_key column makes
// double-apply safe, and updated_at provides last-write-wins basis.

model PendingSync {
  id        String @id @default(cuid())
  userId    String
  // "task.create" / "attendance.resolve" / ...
  actionType String

  // JSON payload of the client intent
  payload   Json
  idempotencyKey String @unique

  status    String @default("PENDING") // PENDING | APPLIED | FAILED
  error     String?
  createdAt DateTime @default(now())
  appliedAt DateTime?
}

// ---------- Immutable event log (analytics) ----------
// A chronological, append-only record of what happened. Events are never
// mutated or deleted after insert; analytics read from here instead of
// re-deriving history from mutating tables.

enum EventType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_UNCOMPLETED
  TASK_UPDATED
  TASK_DELETED
  FOCUS_STARTED
  FOCUS_COMPLETED
  FOCUS_CANCELLED
  ATTENDANCE_RECORDED
  CLASS_SCHEDULED
  CALENDAR_EVENT_SYNCED
  CALENDAR_EVENT_UPDATED
  GOOGLE_TASK_SYNCED
}

model Event {
  id         String    @id @default(cuid())
  userId     String
  type       EventType
  occurredAt DateTime  @default(now())
  payload    Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@map("events")
}